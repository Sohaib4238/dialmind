# Copy to .env and fill in your own values. Never commit .env.
# Nothing is needed to run the tests or the notebook: they use fake values or synthetic data.
# Lines starting with "# NAME=" are optional settings, shown with their default. Uncomment one only to change it.

# ---- Cartesia (voice agent: speech-to-text, LLM, text-to-speech) -----------------------
CARTESIA_API_KEY=
# LLM model ID for the agent (optional; the code has a default)
# CARTESIA_MODEL=
# CARTESIA_TIMEZONE=America/New_York
# Hard cap per call, in minutes (on top of max_call_minutes in config/agent_settings.yaml)
# CARTESIA_MAX_CALL_MINUTES=2
# SIP to Telnyx: tls or tcp. Only used when the trunk is created.
# CARTESIA_SIP_TRANSPORT=tls
# SRTP: disabled / allowed / required. Must match the Telnyx connection. Only used when the trunk is created.
# CARTESIA_SIP_MEDIA_ENCRYPTION=disabled
# CARTESIA_SIP_PROVIDER_LABEL=dialmind-telnyx

# Hard kill switch: 1 = the backend refuses to start any call (demos, tests).
CARTESIA_CALLS_DISABLED=
# 1 = standby copy: changes nothing at Cartesia/Telnyx, no calls, texts or emails.
DIALER_STANDBY=
# Server only: the fixed public address for webhooks and tools (empty = Cloudflare quick tunnel).
PUBLIC_BASE_URL=
# Server only: 1 = no request counts as local, everything needs a login.
DIALER_REQUIRE_LOGIN=

# Written by dashboard/backend/setup_cartesia.py and the backend. Don't edit by hand.
CARTESIA_SIP_PROVIDER_ID=
CARTESIA_FROM_NUMBER_ID=
CARTESIA_AGENT_ID=
CARTESIA_WEBHOOK_ID=
CARTESIA_WEBHOOK_SECRET=
CARTESIA_OUTCOME_TOOL_ID=
CARTESIA_SUPERVISOR_TOOL_ID=
CARTESIA_EMAIL_TOOL_ID=
CARTESIA_TOOL_SECRET=

# cloudflared metrics addresses (the backend reads the quick-tunnel URL from them)
# CLOUDFLARED_METRICS=127.0.0.1:20241
# CLOUDFLARED_DASHBOARD_METRICS=127.0.0.1:20242

# ---- Dashboard login -------------------------------------------------------------------
# Users and roles live in dashboard_users.json next to this file:
#   python dashboard/backend/manage_users.py set NAME --role admin
# Signs the login cookie; generated by the backend on first use.
DASHBOARD_SESSION_SECRET=

# ---- Follow-up emails (plain SMTP) -----------------------------------------------------
# Not set: emails are saved as "not sent (email not configured)".
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Port 465 = SSL; any other port = STARTTLS. SMTP_SECURITY=ssl|starttls|none overrides.
# SMTP_PORT=587
SMTP_SECURITY=
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
# Test mode is ON by default, also when empty: every email goes to EMAIL_TEST_ADDRESS. 0 emails real leads.
EMAIL_TEST_MODE=
EMAIL_TEST_ADDRESS=
# Hard kill switch: 1 = never send (saved as "not sent").
EMAIL_SENDING_DISABLED=
# STOP / unsubscribe replies are read over IMAP with the same login (optional).
IMAP_HOST=
# IMAP_PORT=993

# ---- Telnyx (phone number, SIP, texts) -------------------------------------------------
TELNYX_PHONE_NUMBER=
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
TELNYX_CONNECTION_ID=
TELNYX_OUTBOUND_VOICE_PROFILE_ID=
TELNYX_API_KEY=
# Sending number for texts (empty = TELNYX_PHONE_NUMBER)
TELNYX_SMS_FROM=
TELNYX_MESSAGING_PROFILE_ID=
# Hard kill switch: 1 = no text is ever sent.
SMS_SENDING_DISABLED=
# Webhook public key. Turns on the signed /api/telnyx/* webhooks (delivery status, STOP replies).
TELNYX_PUBLIC_KEY=
# While test mode is on (the default), every call and text goes to this number and nowhere else (E.164).
TEST_CALL_NUMBER=
